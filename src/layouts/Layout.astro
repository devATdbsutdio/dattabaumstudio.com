---
import "../styles/global.css";

import Header from "@/components/Header";
import Footer from "@/components/Footer";
interface Props {
  title?: string;
  description?: string;
  topMargin?: boolean;
}

const title = Astro.props.title || "Datta + Baum Studio";
const description =
  Astro.props.description ||
  "Datta + Baum Studio is a product design studio co-founded by us; Saurabh Datta and Benjamin Baum.";
const topMargin = Astro.props.topMargin || false;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon-v3.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <!-- twitter meta tags -->
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.png" />
  </head>
  <body class="font-main bg-black antialiased">
    <Header solidBg={topMargin} client:load />
    <main class:list={["relative", { "mt-[80px] md:mt-[108px]": topMargin }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @reference "../styles/global.css";
  button,
  a {
    @apply rounded;
  }
  button:focus-visible,
  a:focus-visible {
    @apply outline-none ring-1 ring-neutral-400;
  }

  .font-main {
    font-family: "ABC Diatype", sans-serif;
  }

  .bg-modal {
    background-repeat: repeat;
    background-color: rgba(0, 0, 0, 0.9);
  }

  .bg-content {
    background-repeat: repeat;
    background-image: radial-gradient(
        circle at 50% 100%,
        rgba(0, 0, 0, 0.4),
        rgba(0, 0, 0, 0.5) 10%,
        rgba(0, 0, 0, 1)
      ),
      url("/noise.svg");
  }

  .dbs-container {
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
  }

  .initial {
    position: initial;
  }


  .cart-table::-webkit-scrollbar {
    height: 6px;
  }

  .cart-table::-webkit-scrollbar-thumb {
    @apply bg-gray-600 rounded-lg;
  }

  .cart-table::-webkit-scrollbar-track {
    @apply bg-gray-400 rounded-lg;
  }




  /* FONTS */

  @font-face {
    font-family: "ABC Diatype";
    src: url("/fonts/ABCDiatype-BlackItalic.ttf") format("truetype");
    font-weight: 900;
    font-style: italic;
    font-display: swap;
  }

