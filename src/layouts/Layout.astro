---
import "@fontsource-variable/inter";
import Header from "@/components/Header";
import Footer from "@/components/Footer";

interface Props {
  title?: string;
  description?: string;
  applyTopMargin?: boolean;
}

const title = Astro.props.title || "Datta + Baum Studio";
const description =
  Astro.props.description ||
  "Datta + Baum Studio is a product design studio co-founded by us; Saurabh Datta and Benjamin Baum.";
const applyTopMargin = Astro.props.applyTopMargin || false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="font-sans antialiased bg-black">
    <Header client:load />
    <main class:list={[{ "mt-[80px] md:mt-[108px]": applyTopMargin }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
