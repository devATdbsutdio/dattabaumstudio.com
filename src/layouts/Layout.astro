    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "ABC Diatype";
    src: url("/fonts/ABCDiatype-BoldItalic.ttf") format("truetype");
    font-weight: bold;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "ABC Diatype";
