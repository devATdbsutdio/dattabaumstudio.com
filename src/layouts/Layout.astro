---
import "@fontsource-variable/inter";
import Header from "@/components/Header";
import Footer from "@/components/Footer";

interface Props {
  title?: string;
  description?: string;
  topMargin?: boolean;
}

const title = Astro.props.title || "Datta + Baum Studio";
const description =
  Astro.props.description ||
  "Datta + Baum Studio is a product design studio co-founded by us; Saurabh Datta and Benjamin Baum.";
const topMargin = Astro.props.topMargin || false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-black font-sans antialiased">
    <Header solidBg={topMargin} client:load />
    <main class:list={["relative", { "mt-[80px] md:mt-[108px]": topMargin }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  button,
  a {
    @apply rounded;
  }
  button:focus-visible,
  a:focus-visible {
    @apply outline-none ring-1 ring-neutral-400;
  }

  .bg-modal {
    background-repeat: repeat;
    background-image: radial-gradient(
        circle at 50% 0%,
        rgba(0, 0, 0, 0.5),
        rgba(0, 0, 0, 0.7)
      ),
      url("/noise.svg");
  }

  .bg-content {
    background-repeat: repeat;
    background-image: radial-gradient(
        circle at 50% 100%,
        rgba(0, 0, 0, 0.4),
        rgba(0, 0, 0, 0.5) 10%,
        rgba(0, 0, 0, 1)
      ),
      url("/noise.svg");
  }

  .dbs-container {
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
  }
</style>
