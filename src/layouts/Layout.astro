    src: url("/fonts/ABCDiatype-Regular.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "ABC Diatype";
    src: url("/fonts/ABCDiatype-MediumItalic.ttf") format("truetype");
