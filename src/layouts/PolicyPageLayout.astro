---
import ArrowDownIcon from "@/components/icons/ArrowDownIcon";
import Layout from "@/layouts/Layout.astro";

interface Props {
  frontmatter: any;
}

const { frontmatter } = Astro.props;
---

<Layout>
  <div
    class="bg-black px-5 md:px-8 xl:px-12 pt-[80px] md:pt-[108px] pb-8 md:pb-24"
  >
    <div class="dbs-container relative text-white">
      <div
        class="mt-5 md:mt-20 flex flex-col lg:flex-row lg:items-end lg:justify-between"
      >
        <h1
          class="text-4xl sm:text-6xl lg:text-7xl xl:text-8xl uppercase font-extralight mr-8"
        >
          {frontmatter.title}
        </h1>
        <div
          class="pr-12 text-right text-xl md:text-2xl font-extralight relative mt-8 sm:ml-auto lg:mt-0 lg:ml-0 max-w-lg"
        >
          {frontmatter.description && <p>{frontmatter.description}</p>}
          {
            frontmatter.lastUpdated && (
              <p class="mt-4 md:mt-6">
                Last updated: {frontmatter.lastUpdated}
              </p>
            )
          }
          <button class="absolute right-0 bottom-0.5 scroll-trigger">
            <ArrowDownIcon className="w-10 h-10" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="px-5 py-10 md:px-8 md:py-16 xl:px-12 xl:py-24 bg-white content">
    <div
      class="prose prose-lg md:prose-xl lg:prose-2xl mx-auto w-full max-w-5xl prose-headings:font-light font-light prose-h2:text-3xl md:prose-h2:text-4xl prose-h3:text-2xl md:prose-h3:text-3xl prose-h4:text-xl md:prose-h4:text-2xl"
    >
      <slot />
    </div>
  </div>
</Layout>

<style>
  @media (min-width: 1920px) {
    .dbs-container {
      @apply px-5;
    }
  }
</style>

<script>
  const button = document.querySelector(".scroll-trigger");
  if (button) {
    button.addEventListener("click", () => {
      const content = document.querySelector(".content");
      if (content) {
        content.scrollIntoView({
          behavior: "smooth",
          block: "start",
          inline: "nearest",
        });
      }
    });
  }
</script>
