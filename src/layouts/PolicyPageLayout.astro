---
import ArrowDownIcon from "@/components/icons/ArrowDownIcon";
import Layout from "@/layouts/Layout.astro";

interface Props {
  frontmatter: any;
}

const { frontmatter } = Astro.props;
---

<Layout>
  <div
    class="bg-content px-5 pb-8 pt-[80px] md:px-8 md:pb-24 md:pt-[108px] xl:px-12"
  >
    <div class="dbs-container relative text-white">
      <div
        class="mt-5 flex flex-col md:mt-20 lg:flex-row lg:items-end lg:justify-between"
      >
        <h1
          class="mr-8 text-4xl font-extralight uppercase sm:text-6xl lg:text-7xl xl:text-8xl"
        >
          {frontmatter.title}
        </h1>
        <div
          class="relative mt-8 flex max-w-lg flex-col pr-12 text-right text-xl font-extralight sm:ml-auto md:text-2xl lg:ml-0 lg:mt-0"
        >
          {frontmatter.description && <p>{frontmatter.description}</p>}
          {
            frontmatter.lastUpdated && (
              <p class="mt-4 md:mt-6">
                Last updated: {frontmatter.lastUpdated}
              </p>
            )
          }
          <button class="scroll-trigger absolute bottom-0.5 right-0">
            <ArrowDownIcon className="w-10 h-10" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    class="content w-full overflow-hidden bg-white px-5 py-10 md:px-8 md:py-16 xl:px-12 xl:py-24"
  >
    <div
      class="prose prose-lg mx-auto w-full max-w-5xl font-light md:prose-xl lg:prose-2xl prose-headings:font-light prose-h2:text-3xl prose-h3:text-2xl prose-h4:text-xl prose-a:break-words md:prose-h2:text-4xl md:prose-h3:text-3xl md:prose-h4:text-2xl"
    >
      <slot />
    </div>
  </div>
</Layout>

<style>
  @media (min-width: 1920px) {
    .dbs-container {
      @apply px-5;
    }
  }
</style>

<script>
  const button = document.querySelector(".scroll-trigger");
  if (button) {
    button.addEventListener("click", () => {
      const content = document.querySelector(".content");
      if (content) {
        content.scrollIntoView({
          behavior: "smooth",
          block: "start",
          inline: "nearest",
        });
      }
    });
  }
</script>
