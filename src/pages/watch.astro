---
import Layout from "@/layouts/Layout.astro";
import watchHero1 from "@/assets/images/watch_hero_01.jpg";
import watchHero2 from "@/assets/images/watch_hero_02.jpg";
import watchHero3 from "@/assets/images/watch_hero_03.jpg";
import watchHero4 from "@/assets/images/watch_hero_04.jpg";
import watchHero5 from "@/assets/images/watch_hero_05.jpg";
import { getImage } from "astro:assets";
import HeroCarousel from "@/components/HeroCarousel";
import Button from "@/components/Button";
import WaitingListButton from "@/components/WaitingListButton";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon";
import ArrowDownIcon from "@/components/icons/ArrowDownIcon";

const watchHeroImg1 = await getImage({ src: watchHero1 });
const watchHeroImg2 = await getImage({ src: watchHero2 });
const watchHeroImg3 = await getImage({ src: watchHero3 });
const watchHeroImg4 = await getImage({ src: watchHero4 });
const watchHeroImg5 = await getImage({ src: watchHero5 });

const watchHeroImgs = [
  watchHeroImg1.src,
  watchHeroImg2.src,
  watchHeroImg3.src,
  watchHeroImg4.src,
  watchHeroImg5.src,
];
---

<Layout>
  <div class="relative min-h-screen">
    <HeroCarousel images={watchHeroImgs} client:load />
    <div class="pointer-events-none absolute inset-0 z-10">
      <div
        class="dbs-container flex h-full flex-col justify-end px-5 pb-10 md:px-8 md:pb-24 xl:px-12"
      >
        <h1
          class="mb-9 text-7xl font-extralight text-white md:mb-10 md:text-9xl lg:text-[144px]"
        >
          WATCH
        </h1>
        <div
          class="pointer-events-auto flex flex-col gap-11 xl:flex-row xl:items-center xl:justify-between"
        >
          <div class="flex flex-wrap items-center gap-5">
            <WaitingListButton client:load />
            <Button variant="secondary-dark" href="/faq" className="gap-10">
              FAQ
              <ArrowRightIcon
                className="stroke-white h-8 w-8 md:h-10 md:w-10 stroke-1"
              />
            </Button>
          </div>
          <div
            class="relative ml-auto max-w-xs pr-12 text-right text-base font-extralight text-white sm:max-w-none md:pr-16 md:text-2xl"
          >
            <p>Bringing digital watches to a higher pedestal.</p>
            <button class="scroll-trigger absolute bottom-0.5 right-0">
              <ArrowDownIcon className="w-10 h-10" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="content relative min-h-screen bg-black">
    <div
      class="content-nav-container fixed left-0 right-0 top-6 hidden items-center justify-center sm:top-10 md:top-16"
    >
      <div
        class="content-nav flex overflow-hidden rounded border border-white/30 bg-black"
      >
        <button
          id="watch-button"
          class="p-5 pl-10 text-sm text-white opacity-30 transition-opacity hover:opacity-100 md:p-6 md:pl-12 md:text-base"
        >
          <span class="hidden sm:inline-block">The</span>{" "}Watch</button
        >
        <button
          id="craftsmanship-button"
          class="p-5 text-sm text-white opacity-30 transition-opacity hover:opacity-100 md:p-6 md:text-base"
          >Craftsmanship</button
        >
        <button
          id="specs-button"
          class="p-5 pr-10 text-sm text-white opacity-30 transition-opacity hover:opacity-100 md:p-6 md:pr-12 md:text-base"
        >
          <span class="hidden sm:inline-block">The</span>{" "}Specs</button
        >
        <WaitingListButton
          client:load
          className="border-none hidden md:h-full md:py-6 md:block rounded-none"
        />
      </div>
    </div>
    <div id="watch" class="content-section min-h-screen bg-green-500">
      THE WATCH
    </div>
    <div id="craftsmanship" class="content-section min-h-screen bg-blue-500">
      THE CRAFTSMANSHIP
    </div>
    <div id="specs" class="content-section min-h-screen bg-red-500">
      THE SPECS
    </div>
  </div>
</Layout>

<style>
  @media (min-width: 1920px) {
    .dbs-container {
      @apply px-5;
    }
  }
</style>

<script>
  const button = document.querySelector(".scroll-trigger");
  if (button) {
    button.addEventListener("click", () => {
      const content = document.querySelector(".content");
      if (content) {
        content.scrollIntoView({
          behavior: "smooth",
          block: "start",
          inline: "nearest",
        });
      }
    });
  }

  window.addEventListener("load", () => {
    const contentNavContainer = document.querySelector(
      ".content-nav-container",
    );
    const watchSection = document.querySelector("#watch");
    const watchButton = document.querySelector("#watch-button");
    const craftsmanshipSection = document.querySelector("#craftsmanship");
    const craftsmanshipButton = document.querySelector("#craftsmanship-button");
    const specsSection = document.querySelector("#specs");
    const specsButton = document.querySelector("#specs-button");

    const highlightButton = (button: Element | null) => {
      button?.classList.remove("opacity-30");
      button?.classList.add("opacity-100");
    };

    const unhighlightButton = (button: Element | null) => {
      button?.classList.remove("opacity-100");
      button?.classList.add("opacity-30");
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries.filter((entry) => entry.isIntersecting)[0];
        if (entry.target.id === "watch") {
          highlightButton(watchButton);
          unhighlightButton(craftsmanshipButton);
          unhighlightButton(specsButton);
        } else if (entry.target.id === "craftsmanship") {
          highlightButton(craftsmanshipButton);
          unhighlightButton(watchButton);
          unhighlightButton(specsButton);
        } else if (entry.target.id === "specs") {
          highlightButton(specsButton);
          unhighlightButton(watchButton);
          unhighlightButton(craftsmanshipButton);
        } else {
          unhighlightButton(watchButton);
          unhighlightButton(craftsmanshipButton);
          unhighlightButton(specsButton);
        }
      },
      {
        threshold: 0.5,
      },
    );

    if (watchSection) {
      observer.observe(watchSection);
      watchButton?.addEventListener("click", () => {
        watchSection.scrollIntoView({
          behavior: "smooth",
          block: "start",
          inline: "nearest",
        });
      });
    }

    if (craftsmanshipSection) {
      observer.observe(craftsmanshipSection);
      craftsmanshipButton?.addEventListener("click", () => {
        craftsmanshipSection.scrollIntoView({
          behavior: "smooth",
          block: "start",
          inline: "nearest",
        });
      });
    }

    if (specsSection) {
      observer.observe(specsSection);
      specsButton?.addEventListener("click", () => {
        specsSection.scrollIntoView({
          behavior: "smooth",
          block: "start",
          inline: "nearest",
        });
      });
    }

    const showContentNav = () => {
      if (
        contentNavContainer &&
        contentNavContainer.classList.contains("hidden")
      ) {
        contentNavContainer.classList.remove("hidden");
        contentNavContainer.classList.add(
          "flex",
          "animate-in",
          "fade-in",
          "zoom-in-75",
        );
      }
    };

    const hideContentNav = () => {
      if (
        contentNavContainer &&
        !contentNavContainer.classList.contains("hidden")
      ) {
        contentNavContainer.classList.add("hidden");
        contentNavContainer.classList.remove(
          "flex",
          "animate-in",
          "fade-in",
          "zoom-in-75",
        );
      }
    };

    const handleContentNavVisibility = () => {
      if (contentNavContainer) {
        const shouldNavBeHidden = window.scrollY < window.innerHeight;
        if (shouldNavBeHidden) {
          hideContentNav();
        } else {
          showContentNav();
        }
      }
    };

    handleContentNavVisibility();

    window.addEventListener("scroll", () => {
      handleContentNavVisibility();
    });
  });
</script>
