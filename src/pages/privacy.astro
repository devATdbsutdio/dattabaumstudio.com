---
import TextPage from "@/components/TextPage.astro";
import * as data from "@/data/lorem.md";

const title = "Privacy Policy";
const description =
  "We care about your privacy and our below policy explains that how we handle the data.";
const lastUpdated = "March 22, 2023";
const content = data.compiledContent();
---

<TextPage
  title={title}
  description={description}
  lastUpdated={lastUpdated}
  content={content}
/>
