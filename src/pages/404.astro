---
import Button from '@/components/Button';
import ArrowRightIcon from '@/components/icons/ArrowRightIcon';
import Layout from '@/layouts/Layout.astro';
---

<Layout>
	<div
		class="bg-modal flex min-h-[calc(100vh-492px)] flex-col justify-center px-5 py-20 md:min-h-[calc(100vh-196px)] md:px-12 md:py-10 xl:min-h-[calc(100vh-144px)]">
		<h1 class="mb-2 text-8xl text-white">404</h1>
		<p class="text-4xl text-white">PAGE NOT FOUND</p>
		<Button variant="primary-dark" href="/" className="mt-10 gap-10 self-start">
			Go to Home
			<ArrowRightIcon className="h-8 w-8 stroke-black stroke-1 group-hover:stroke-white md:h-10 md:w-10" />
		</Button>
	</div>
</Layout>
