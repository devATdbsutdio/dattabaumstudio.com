---
import Button from "@/components/Button";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div
    class="min-h-[calc(100vh_-_492px)] md:min-h-[calc(100vh_-_196px)] xl:min-h-[calc(100vh_-_144px)] px-5 md:px-12 py-20 md:py-10 flex flex-col justify-center bg-modal"
  >
    <h1 class="text-8xl text-white mb-2">404</h1>
    <p class="text-4xl text-white">PAGE NOT FOUND</p>
    <Button variant="primary-dark" href="/" className="self-start mt-10 gap-10">
      Go to Home
      <ArrowRightIcon
        className="stroke-black group-hover:stroke-white h-8 w-8 md:h-10 md:w-10 stroke-1"
      />
    </Button>
  </div>
</Layout>
