---
import '../styles/global.css';

import ArrowDownIcon from '@/components/icons/ArrowDownIcon';
import Layout from '@/layouts/Layout.astro';

const contacts = [
	{
		title: 'Write to us',
		description:
			'For questions about the watch, help with an order or a technical issue, feedback, or just saying hi. We are also open to collaborations.',
		email: 'hi@dattabaumstudio.com',
	},
];
---

<Layout>
	<div class="bg-content px-5 pt-[80px] pb-8 md:px-8 md:pt-[108px] md:pb-24 xl:px-12">
		<div class="dbs-container relative text-white">
			<div class="mt-5 flex flex-col md:mt-20 lg:flex-row lg:items-end lg:justify-between">
				<h1 class="mr-8 text-4xl font-extralight uppercase sm:text-6xl lg:text-7xl xl:text-8xl">Contacts</h1>
				<div
					class="relative mt-8 max-w-lg pr-12 text-right text-xl font-extralight sm:ml-auto md:text-2xl lg:mt-0 lg:ml-0">
					<p>Write to us at the address below. We usually respond within 48 hours.</p>
					<button class="scroll-trigger absolute right-0 bottom-0.5">
						<ArrowDownIcon className="h-10 w-10" />
					</button>
				</div>
			</div>
		</div>
	</div>
	<div class="content bg-white px-5 py-10 md:px-8 md:py-16 xl:px-12 xl:py-24">
		{
			contacts.map((contact, idx) => (
				<div
					class:list={[
						'border-black py-8 md:py-16',
						{
							'border-y': idx === 0,
							'border-b': idx !== 0,
						},
					]}>
					<div class="dbs-container md:flex md:items-end">
						<div class="md:w-fit">
							<h3 class="text-xl font-semibold">{contact.title}</h3>
							<p class="mt-4 mr-24 md:w-full md:max-w-sm lg:mr-36 xl:mr-52">{contact.description}</p>
						</div>
						<a
							href={`mailto:${contact.email}`}
							class="mt-6 block w-fit rounded-none text-2xl font-light underline md:text-4xl">
							{contact.email}
						</a>
					</div>
				</div>
			))
		}
	</div>
</Layout>

<style>
	@reference "../styles/global.css";

	@media (min-width: 1920px) {
		.dbs-container {
			@apply px-5;
		}
	}
</style>

<script>
	const button = document.querySelector('.scroll-trigger');
	if (button) {
		button.addEventListener('click', () => {
			const content = document.querySelector('.content');
			if (content) {
				content.scrollIntoView({
					behavior: 'smooth',
					block: 'start',
					inline: 'nearest',
				});
			}
		});
	}
</script>
