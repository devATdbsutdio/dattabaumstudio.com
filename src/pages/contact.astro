---
import ArrowDownIcon from "@/components/icons/ArrowDownIcon";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div
    class="relative px-5 md:px-8 xl:px-12 text-white bg-black pt-[80px] md:pt-[108px] pb-8 md:pb-24"
  >
    <div
      class="mt-5 md:mt-20 flex flex-col lg:flex-row lg:items-end lg:justify-between"
    >
      <h1
        class="text-4xl sm:text-6xl lg:text-7xl xl:text-8xl uppercase font-extralight md:mr-8"
      >
        Contacts
      </h1>
      <p
        class="pr-12 text-right text-xl md:text-2xl font-extralight relative ml-20 mt-8 sm:ml-auto lg:mt-0 lg:ml-0 max-w-lg"
      >
        Below, are the various ways you can reach us by writing. We usually
        respond within 48 hours.
        <ArrowDownIcon className="absolute right-0 bottom-0.5 w-10 h-10" />
      </p>
    </div>
  </div>
</Layout>
