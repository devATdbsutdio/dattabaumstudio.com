---
import { getImage } from "astro:assets";
import Button from "@/components/Button";
import sync from "@/assets/images/sync-in-progress.png";

const syncImg = await getImage({ src: sync });
---

<div
  class={`relative z-30 hidden group-data-[active-step='5']/sync-steps:flex`}
  id="sync-in-progress"
>
  <div class="bg-modal fixed inset-0"></div>
  <div class="fixed inset-0 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center text-center md:p-4">
      <div
        class="relative min-h-screen w-screen transform flex-col overflow-hidden bg-white px-4 py-6 text-left align-middle shadow-xl transition-all only:flex md:h-[672px] md:min-h-fit md:w-full md:max-w-5xl md:rounded-3xl md:px-32 md:py-32"
      >
        <h3 class="mb-4 text-center text-3xl uppercase md:text-5xl">
          SYNCING TIME LEFT:
        </h3>
        <h4
          id="time-left"
          class="mb-6 text-center text-3xl font-semibold uppercase md:text-5xl"
        >
        </h4>
        <p class="mb-16 text-center">
          Now <strong>press</strong> the button on the watch, <strong>twice</strong>, slowly, with a small gap in between each press, for it to accept the new date and time.
          to be safe).
        </p>
        <div id="sync-time-in-progress" class="mx-auto flex">
          <picture class="h-36 w-36">
            <img src={syncImg.src} alt="" class="h-full w-full object-contain" />
          </picture>
          <div
            class="animate-bounceLeft ml-1 mt-10 h-0 w-0 border-b-[10px] border-r-[15px] border-t-[10px] border-b-transparent border-r-black border-t-transparent"
          >
          </div>
        </div>
        <div id="sync-time-complete" class="mt-auto hidden items-center gap-4">
          <Button
            id="btn-sync-time-restart"
            variant="primary-light"
            className="w-full"
          >
            Restart
          </Button>
          <Button
            id="btn-sync-time-close"
            variant="secondary-light"
            className="w-full"
          >
            Close
          </Button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .animate-bounceLeft {
    animation: bounceLeft 1.5s infinite;
  }

  @keyframes bounceLeft {
    0%,
    100% {
      transform: translateX(50%);
      animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
    }
    50% {
      transform: translateX(0);
      animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
    }
  }
</style>

<script is:inline>
  const syncTimeInProgress = document.querySelector("#sync-time-in-progress");
  const syncTimeComplete = document.querySelector("#sync-time-complete");

  const closeBtn = document.querySelector("#btn-sync-time-close");
  closeBtn.addEventListener("click", () => {
    stepsWrapper.dataset.activeStep = "0";
    console.log("*** CLOSE");
    syncTimeComplete.classList.remove("flex");
    syncTimeComplete.classList.add("hidden");
    syncTimeInProgress.classList.remove("hidden");
    syncTimeInProgress.classList.add("flex");
  });

  const restartBtn = document.querySelector("#btn-sync-time-restart");
  restartBtn.addEventListener("click", () => {
    stepsWrapper.dataset.activeStep = "1";
    console.log("*** RESTART");
    syncTimeComplete.classList.remove("flex");
    syncTimeComplete.classList.add("hidden");
    syncTimeInProgress.classList.remove("hidden");
    syncTimeInProgress.classList.add("flex");
  });
</script>
