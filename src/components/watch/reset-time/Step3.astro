---
import Button from "@/components/Button";
import StepWrapper from "./StepWrapper.astro";
---

<StepWrapper step="3" title="3/4: Select “stay awake” duration" showBackBtn>
  <label for="stay-awake-duration" class="mb-4 text-2xl font-semibold"
    >Select “stay awake” duration:</label
  >
  <select
    name="stay-awake-duration"
    id="stay-awake-duration"
    class="group relative mb-8 inline-flex h-12 items-center justify-center rounded border border-black/30 bg-transparent px-10 text-lg transition-colors hover:border-black disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:h-16"
  >
    <option value="1">1 seconds</option>
    <option value="2">2 seconds</option>
    <option value="3">3 seconds</option>
    <option value="4">4 seconds</option>
    <option value="5" selected>5 seconds</option>
    <option value="6">6 seconds</option>
    <option value="7">7 seconds</option>
    <option value="8">8 seconds</option>
    <option value="9">9 seconds</option>
    <option value="10">10 seconds</option>
  </select>
  <Button id="btn-sync-time-step-3" variant="primary-light" className="w-full">
    Done
  </Button>
</StepWrapper>

<script is:inline>
  const btnSyncTimeStep3 = document.querySelector("#btn-sync-time-step-3");
  const stayAwakeDuration = document.querySelector("#stay-awake-duration");

  btnSyncTimeStep3.addEventListener("click", () => {
    stepsWrapper.dataset.activeStep = "4";
    console.log("*** MOVE TO STEP 4");
  });

  stayAwakeDuration.addEventListener("change", () => {
    console.log("*** STAY AWAKE DURATION CHANGED");
    stepsWrapper.dataset.stayAwakeDuration = stayAwakeDuration.value;
  });
</script>
