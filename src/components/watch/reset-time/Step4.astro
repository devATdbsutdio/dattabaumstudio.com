---
import Button from "@/components/Button";
import StepWrapper from "./StepWrapper.astro";
---

<StepWrapper
  step="4"
  title="4/4: Sync Time and DATE from your computer"
  showBackBtn
>
  <div class="mb-14 space-y-8">
    <p>
      After you
      <strong> click the “sync” button below</strong>
       , the browser will stream the time and date data to the watch (by
      pinging for 10 secs).
    </p>
    <p>
      During that period, press the physical button on the watch <strong>ONCE</strong>
       , so that it can wake up and receive the time and date data.
    </p>
  </div>
  <Button
    id="btn-sync-time-step-4"
    variant="primary-light"
    className="w-full mt-auto"
  >
    Sync time and date
  </Button>
</StepWrapper>

<script is:inline>
  const btnSyncTimeStep4 = document.querySelector("#btn-sync-time-step-4");

  btnSyncTimeStep4.addEventListener("click", () => {
    writeDateAndTimeData();
  });

  const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  const writeDateAndTimeData = async (_) => {
    console.log("*** START SYNCING");
    stepsWrapper.dataset.activeStep = "5";

    for (let i = 1; i < maxWrites + 1; i++) {
      currWriteCount = maxWrites - i;
      console.log(`*** ${currWriteCount} WRITES LEFT`);
      const timeLeft = document.querySelector("#time-left");

      if (currWriteCount > 0) {
        timeLeft.innerHTML = `${currWriteCount} SECONDS`;
      } else {
        timeLeft.innerHTML = `DONE!`;
      }

      const now = new Date();
      var month_ = now.getMonth() + 1;

      let stayAwakeDuration = stepsWrapper.dataset.stayAwakeDuration || "5";
      // let stayAwakeDurationMs = Number(stayAwakeDuration) * 1000;

      serialData =
        now.getHours() +
        ":" +
        now.getMinutes() +
        ":" +
        now.getSeconds() +
        ":" +
        now.getDay() +
        ":" +
        now.getDate() +
        ":" +
        month_ +
        ":" +
        now.getFullYear() +
        ":" +
        stayAwakeDuration; //stayAwakeDurationMs

      if (port != null && port.writable) writeToStream(serialData);
      else
        console.log(
          "*** NOT WRITING TO SERIAL PORT AS IT WASN'T CREATED/SELECTED!\n" +
            serialData,
        );

      await delay(writeFrequency);
    }

    const syncTimeCompleteDiv = document.querySelector("#sync-time-complete");
    const syncTimeInProgressDiv = document.querySelector(
      "#sync-time-in-progress",
    );

    syncTimeCompleteDiv.classList.remove("hidden");
    syncTimeCompleteDiv.classList.add("flex");
    syncTimeInProgressDiv.classList.remove("flex");
    syncTimeInProgressDiv.classList.add("hidden");

    if (outputStream) {
      console.log("*** CLOSE OUTPUT STREAM");
      await outputStream.getWriter().close();
      await outputDone;
      outputStream = null;
      outputDone = null;
    }
    if (port) {
      console.log("*** CLOSE PORT");
      await port.close();
      console.log("*** SERIAL DISCONNECTED");
      port = null;
      serialConnected = false;
      disconnectCounter = 0;
    }
  };

  function writeToStream(...lines) {
    const writer = outputStream.getWriter();

    lines.forEach((line) => {
      console.log("*** [SEND]", line);
      writer.write(line + "\n");
    });
    writer.releaseLock();
  }
</script>
