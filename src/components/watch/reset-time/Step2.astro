---
import Button from "@/components/Button";
import StepWrapper from "./StepWrapper.astro";
---

<StepWrapper step="2" title="2/4: Select the connected computer port">
  <Button id="btn-sync-time-step-2" variant="primary-light" className="w-full">
    Select Port
  </Button>
</StepWrapper>

<script is:inline>
  const btnSyncTimeStep2 = document.querySelector("#btn-sync-time-step-2");

  btnSyncTimeStep2.addEventListener("click", async () => {
    console.log("*** ATTEMPTING TO CONNECT TO PORT");
    port = await navigator.serial.requestPort();

    console.log("*** PORT REQUESTED", port);

    try {
      await port.open({ baudRate: baudrate });
      console.log("*** PORT OPENED", port);

      if (port.writable && port.readable) {
        const encoder = new TextEncoderStream();
        outputDone = encoder.readable.pipeTo(port.writable);
        outputStream = encoder.writable;

        serialConnected = true;

        disconnectCounter = 0;

        console.log("*** PORT CONNECTED");

        stepsWrapper.dataset.activeStep = "3";
        console.log("*** MOVE TO STEP 3");
      }
    } catch (e) {
      console.log("*** ERROR OPENING PORT");
      console.log(e);
    }
  });
</script>
