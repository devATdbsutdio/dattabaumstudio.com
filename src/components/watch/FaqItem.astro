---
import ChevronDownIcon from "../icons/ChevronDownIcon";
const { title, showBottomBorder, isSmallSize } = Astro.props;
---

<div
  data-state="closed"
  class:list={[
    "faq-item group w-full",
    showBottomBorder && "border-b border-black/30",
  ]}
>
  <button
    aria-label="Expand FAQ item"
    class:list={[
      "flex w-full items-center justify-between gap-5 rounded-none py-6 text-left text-lg font-light md:py-10 md:text-4xl",
    ]}
  >
    <span class="max-w-3xl" class:list={[isSmallSize && "text-2xl"]}
      >{title}</span
    >
    <ChevronDownIcon
      className="h-10 w-10 transform group-data-[state=open]:rotate-180"
    />
  </button>
  <div
    class="max-w-3xl pb-6 font-light group-data-[state=closed]:hidden md:pb-10 md:text-2xl"
  >
    <slot />
  </div>
</div>

<script>
  const items = document.querySelectorAll(
    ".faq-item",
  ) as NodeListOf<HTMLDivElement>;

  items.forEach((item) => {
    const itemButton = item.querySelector("button") as HTMLButtonElement;

    itemButton.addEventListener("click", () => {
      const state = item.dataset.state;
      item.dataset.state = state === "open" ? "closed" : "open";
    });
  });
</script>
