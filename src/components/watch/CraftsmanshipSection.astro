<div id="craftsmanship" class="pointer-events-auto overflow-x-clip">
  <div class="bg-craftsmanship px-5 pb-6 pt-32 md:px-8 md:pt-40 xl:px-12">
    <div class="dbs-container">
      <h2
        class="text-4xl font-extralight uppercase text-white sm:text-6xl lg:text-7xl xl:text-8xl"
      >
        RIGOUR FOR<br /> QUALITY AND STYLE
      </h2>

      <CraftCarousel client:idle />
    </div>
  </div>
</div>

