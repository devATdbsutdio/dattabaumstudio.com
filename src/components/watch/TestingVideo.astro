---
import XIcon from '@/components/icons/XIcon';
import { mediaPath } from '@/constants';
---

<div>
	<button id="testing-video-open" class="underline">Watch it here</button>
	<div class={`relative z-30 hidden`} id="testing-video-container">
		<div class="bg-modal fixed inset-0"></div>
		<div class="fixed inset-0 overflow-y-auto">
			<div class="flex min-h-full items-center justify-center text-center md:p-4">
				<div
					class="relative min-h-screen w-screen transform flex-col overflow-hidden bg-white px-4 py-6 text-left align-middle shadow-xl transition-all only:flex md:h-[672px] md:min-h-fit md:w-full md:max-w-5xl md:rounded-3xl md:px-10 md:py-10">
					<div class="flex items-center justify-between">
						<button
							id="testing-video-close"
							class="z-10 mb-4 ml-auto inline-flex items-center gap-2 self-start bg-black/10 p-2 text-white backdrop-blur-sm transition-colors">
							Close
							<XIcon className="text-white" />
						</button>
					</div>
					<div class="absolute inset-0 h-full w-full bg-black">
						<video id="testing-video" preload="auto" controls="controls" class="h-full w-full">
							<source src={`${mediaPath}/power_saving_test.mp4?alt=media`} type="video/mp4" />
							<track kind="captions" label="No captions" srclang="en" src="" default />
						</video>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	const testingVideo = document.querySelector('#testing-video');
	const testingVideoContainer = document.querySelector('#testing-video-container');

	const testingCloseBtn = document.querySelector('#testing-video-close');
	testingCloseBtn.addEventListener('click', () => {
		console.log('*** CLOSE');
		testingVideoContainer.classList.remove('flex');
		testingVideoContainer.classList.add('hidden');
		testingVideo.pause();
	});

	const testingOpenBtn = document.querySelector('#testing-video-open');
	testingOpenBtn.addEventListener('click', () => {
		console.log('*** OPEN');
		testingVideoContainer.classList.remove('hidden');
		testingVideoContainer.classList.add('flex');
		testingVideo.play();
	});
</script>
