---
import ArrowDownIcon from "@/components/icons/ArrowDownIcon";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
  content: string;
}

const { title, description, lastUpdated, content } = Astro.props;
---

<Layout>
  <div
    class="relative px-5 md:px-8 xl:px-12 text-white bg-black pt-[80px] md:pt-[108px] pb-8 md:pb-24"
  >
    <div
      class="mt-5 md:mt-20 flex flex-col lg:flex-row lg:items-end lg:justify-between"
    >
      <h1
        class="text-4xl sm:text-6xl lg:text-7xl xl:text-8xl uppercase font-extralight mr-8"
      >
        {title}
      </h1>
      <div
        class="pr-12 text-right text-xl md:text-2xl font-extralight relative mt-8 sm:ml-auto lg:mt-0 lg:ml-0 max-w-lg"
      >
        <p>
          {description}
        </p>
        <p class="mt-4 md:mt-6">Last updated: {lastUpdated}</p>
        <ArrowDownIcon className="absolute right-0 bottom-0.5 w-10 h-10" />
      </div>
    </div>
  </div>
  <div class="px-5 py-10 md:px-8 md:py-16 xl:px-12 xl:py-24 bg-white">
    <div
      class="prose prose-lg md:prose-xl lg:prose-2xl mx-auto w-full max-w-5xl"
      set:html={content}
    />
  </div>
</Layout>
